<?xml version="1.0"?>
<ruleset name="yii2-filesystem">
    <description>PSR-12</description>
    <rule ref="PSR12"/>

    <!--
        PHP_CodeSniffer 4.0 can't tokenize PHP 8.4 property hooks yet
        (https://github.com/PHPCSStandards/PHP_CodeSniffer/issues/734)
        and reports the $tempDir hook as invalid property declarations.
    -->
    <rule ref="PSR2.Classes.PropertyDeclaration">
        <exclude-pattern>*/src/FileExport/Service.php</exclude-pattern>
    </rule>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <exclude-pattern>*/src/FileExport/Service.php</exclude-pattern>
    </rule>
</ruleset>
